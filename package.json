{
  "name": "book-keeping",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "start": "ts-node src/index.ts",
    "dev": "ts-node --transpile-only src/index.ts",
    "sync-db": "ts-node scripts/sync-db.ts",
    "test": "node --require ts-node/register --test src/test/*.test.ts",
    "test:manual": "ts-node src/test/run.ts",
    "test:di": "ts-node src/test/diSanityCheck.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.11.3",
    "@grpc/proto-loader": "^0.7.13",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.3",
    "sequelize-typescript": "^2.1.6",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/validator": "^13.11.9",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
